<Window x:Class="AM.TribonAutomationProbe.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="船舶设计智能助手"
        Width="1280"
        Height="900"
        MinWidth="1080"
        MinHeight="760"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{StaticResource PrimaryBrush}"
            Padding="24,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel>
          <TextBlock Text="船舶设计智能助手"
                     Foreground="White"
                     FontSize="25"
                     FontWeight="SemiBold" />
          <TextBlock Text="自然语言对话、实时执行状态与受控图纸操作"
                     Foreground="#D9EAF2"
                     Margin="0,4,0,0"
                     FontSize="14" />
        </StackPanel>

        <Border Grid.Column="1"
                Background="#1C4861"
                CornerRadius="5"
                Padding="12,7"
                VerticalAlignment="Center">
          <TextBlock Text="自动执行 · 写入需确认"
                     Foreground="White"
                     FontWeight="SemiBold" />
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto">
      <Grid Margin="22">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.9*" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0"
                  Style="{StaticResource CardStyle}"
                  Margin="0,0,14,14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="360" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0"
                          Margin="0,0,0,12">
                <TextBlock Text="对话任务入口"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="自然语言负责理解任务；系统会通过受控 Tribon 执行通道自动完成已验证操作，任何图纸写入仍需你的明确确认。"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0" />

                <Expander Header="{Binding ModelSettingsHeader}"
                          IsExpanded="False"
                          Margin="0,10,0,0">
                  <Border Background="#F3F7F9"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="5"
                          Padding="10"
                          Margin="0,6,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <TextBlock Text="Base URL"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                      <TextBox Grid.Column="1"
                               Text="{Binding AssistantBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                               Margin="0,0,8,0" />
                      <TextBox Grid.Column="2"
                               Text="{Binding AssistantModel, UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="模型 ID" />

                      <TextBlock Grid.Row="1"
                                 Text="Token"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,8,8,0" />
                      <PasswordBox x:Name="AssistantApiTokenBox"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   Margin="0,8,8,0"
                                   PasswordChanged="AssistantApiTokenBox_PasswordChanged"
                                   ToolTip="Token 使用 Windows 当前用户加密后持久保存；已保存时可留空继续使用。" />
                      <StackPanel Grid.Row="1"
                                  Grid.Column="2"
                                  Margin="0,8,0,0">
                        <TextBlock Text="{Binding ModelCredentialStatus}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ModelConfigurationSummary}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                      </StackPanel>

                      <StackPanel Grid.Row="2"
                                  Grid.Column="1"
                                  Grid.ColumnSpan="2"
                                  Orientation="Horizontal"
                                  Margin="0,8,0,0">
                        <TextBlock Text="模型配置会自动保存；没有可用 Token 时无法发送任务。"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Content="清除已保存 Token"
                                Margin="12,0,0,0"
                                Padding="8,3"
                                IsEnabled="{Binding HasModelCredential}"
                                Click="ClearAssistantToken_Click" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </Expander>
              </StackPanel>

              <Border Grid.Row="1"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="5"
                      Background="#F8FAFB"
                      Padding="8">
                <ScrollViewer x:Name="ConversationScrollViewer"
                              VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Padding="11,8"
                                Margin="2,3"
                                MaxWidth="610">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="#EAF0F3" />
                              <Setter Property="CornerRadius" Value="6" />
                              <Setter Property="HorizontalAlignment" Value="Left" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Role}" Value="user">
                                  <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                  <Setter Property="HorizontalAlignment" Value="Right" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Role}" Value="system">
                                  <Setter Property="Background" Value="#FFF3D9" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <StackPanel>
                            <TextBlock Text="{Binding DisplayRole}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,3">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Role}" Value="user">
                                      <Setter Property="Foreground" Value="#D9EAF2" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Content}"
                                       TextWrapping="Wrap">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Role}" Value="user">
                                      <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>

              <Border Grid.Row="2"
                      Background="#F3F7F9"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="5"
                      Padding="10"
                      Margin="0,10,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ProgressBar Width="42"
                               Height="4"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               IsIndeterminate="{Binding IsBusy, Mode=OneWay}"
                               Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding ExecutionStateText}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ExecutionStatus}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                  </StackPanel>
                </Grid>
              </Border>

              <TextBox x:Name="UserInputBox"
                       Grid.Row="3"
                       Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"
                       MinHeight="80"
                       MaxHeight="130"
                       Margin="0,12,0,8"
                       KeyDown="UserInput_KeyDown"
                       ToolTip="Ctrl+Enter 发送任务" />

              <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Ctrl+Enter 发送任务"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="发送"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="{Binding CanInterpret}"
                        Click="Interpret_Click"
                        Margin="8,0,0,0" />
                <Button Grid.Column="2"
                        Content="取消"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{Binding CanCancel}"
                        Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Click="Cancel_Click"
                        Margin="8,0,0,0" />
                <Button Grid.Column="3"
                        Content="清空对话"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="ClearConversation_Click"
                        Margin="8,0,0,0" />
              </Grid>

              <Border Grid.Row="5"
                      Background="#FDECEC"
                      BorderBrush="#E8B7B7"
                      BorderThickness="1"
                      CornerRadius="5"
                      Padding="10"
                      Margin="0,10,0,0"
                      Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap" />
              </Border>
            </Grid>
          </Border>

          <StackPanel Grid.Column="1">
            <Border Style="{StaticResource CardStyle}"
                    Visibility="{Binding HasPlan, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Expander Header="执行计划详情"
                        IsExpanded="False">
                <StackPanel>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="执行计划"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PlanMessage}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,5,12,0" />
                  </StackPanel>
                  <Border Grid.Column="1"
                          Background="#E7EEF2"
                          CornerRadius="4"
                          Padding="8,4"
                          VerticalAlignment="Top">
                    <TextBlock Text="{Binding ExecutionStateText}"
                               FontWeight="SemiBold" />
                  </Border>
                </Grid>

                <Border Background="#F3F7F9"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="10"
                        Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Text="{Binding ExecutionStatus}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="执行状态由计划生成、确定性执行和写入确认共同驱动。"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                  </StackPanel>
                </Border>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="Plan ID"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding PlanId}"
                             FontFamily="Consolas"
                             TextWrapping="Wrap" />
                  <TextBlock Grid.Row="1"
                             Text="模型"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             Margin="0,5,0,0" />
                  <TextBlock Grid.Row="1"
                             Grid.Column="1"
                             Text="{Binding ModelSummary}"
                             Margin="0,5,0,0" />
                </Grid>

                <ItemsControl ItemsSource="{Binding PlanTasks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1"
                              CornerRadius="5"
                              Padding="10"
                              Margin="0,0,0,8">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Sequence}"
                                     FontSize="18"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource PrimaryBrush}" />
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TaskType}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ConfirmationText}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,2,0,0" />
                          </StackPanel>
                          <Border Grid.Column="2"
                                  Background="#EEF3F6"
                                  CornerRadius="4"
                                  Padding="7,3"
                                  VerticalAlignment="Top">
                            <TextBlock Text="{Binding RiskText}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="#FFF8E8"
                        BorderBrush="#E7D19A"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="10"
                        Margin="0,2,0,10">
                  <TextBlock Text="{Binding PlanSafetySummary}"
                             Foreground="{StaticResource WarningBrush}"
                             TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="{Binding PlanExecutionLifecycleSummary}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Margin="0,7,0,0" />

                <Border Background="#EEF5F7"
                        BorderBrush="#C5D8DF"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="10"
                        Margin="0,8,0,0"
                        Visibility="{Binding ShowReadOnlyExecutionPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <StackPanel>
                    <TextBlock Text="确定性只读执行"
                               FontWeight="SemiBold" />
                    <ProgressBar Value="{Binding ReadOnlyExecutionProgress, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsReadOnlyExecutionProgressIndeterminate, Mode=OneWay}"
                                 Margin="0,7,0,6" />
                    <TextBlock Text="{Binding ReadOnlyExecutionStatus}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ReadOnlyExecutionSummary}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0"
                               Visibility="{Binding HasReadOnlyExecutionResult, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  </StackPanel>
                </Border>

                <TextBlock Text="只读任务会按顺序自动执行；需要创建标签时，系统会先完成安全检查，再等待一次明确确认。系统不会自动保存图纸。"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Margin="0,7,0,0" />
                </StackPanel>
              </Expander>
            </Border>

            <Expander Header="高级运行诊断"
                      IsExpanded="False">
              <Border Style="{StaticResource CardStyle}"
                      Margin="0,8,0,14"
                      IsEnabled="{Binding LabelWorkflow.CanRunPreflight}">
                <StackPanel>
                  <TextBlock Text="普通用户无需修改。这里仅用于诊断 Tribon 执行通道；路径或等待参数改变后，已有标签安全检查结果将失效。"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             TextWrapping="Wrap"
                             Margin="0,0,0,10" />
                  <TextBlock Text="执行器路径（诊断）"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                  <Grid Margin="0,4,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding LabelWorkflow.ConsolePath, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,0" />
                    <Button Grid.Column="1"
                            Content="浏览"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BrowseConsole_Click" />
                  </Grid>

                  <TextBlock Text="通信目录（诊断）"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBox Text="{Binding LabelWorkflow.BridgeRoot, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,4,0,10" />

                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="超时 (ms)"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <TextBox Width="110"
                             Text="{Binding LabelWorkflow.TimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="轮询 (ms)"
                               VerticalAlignment="Center"
                               Margin="14,0,6,0" />
                    <TextBox Width="90"
                             Text="{Binding LabelWorkflow.PollIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </Expander>
          </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}">
          <StackPanel>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="标签执行状态"
                           FontSize="17"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding LabelWorkflow.StatusMessage}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,5,18,0" />
              </StackPanel>
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          VerticalAlignment="Center">
                <Button Content="取消"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{Binding CanCancel}"
                        Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Click="Cancel_Click" />
              </StackPanel>
            </Grid>

            <ProgressBar Value="{Binding LabelWorkflow.ProgressPercent, Mode=OneWay}"
                         IsIndeterminate="{Binding LabelWorkflow.IsProgressIndeterminate}" />

            <Border Background="#FDECEC"
                    BorderBrush="#E8B7B7"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="12"
                    Margin="0,12,0,0"
                    Visibility="{Binding LabelWorkflow.HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="{Binding LabelWorkflow.ErrorMessage}"
                         Foreground="{StaticResource ErrorBrush}"
                         TextWrapping="Wrap" />
            </Border>

            <Border Background="#FFF8E8"
                    BorderBrush="#E7D19A"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="12"
                    Margin="0,12,0,0">
              <TextBlock Foreground="{StaticResource WarningBrush}"
                         TextWrapping="Wrap">
                <Run Text="Tribon 执行通道会自动处理只读检查和已授权的图纸修改。" FontWeight="Bold" />
                <Run Text=" 正常使用无需运行任何脚本；系统不会自动保存图纸。" />
              </TextBlock>
            </Border>
          </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Visibility="{Binding LabelWorkflow.HasPreflight, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="标签安全检查结果"
                         FontSize="17"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Content="创建标签"
                      Style="{StaticResource PrimaryButtonStyle}"
                      IsEnabled="{Binding CanCreateLabelsFromPreflight}"
                      Visibility="{Binding ShowCreateLabelsFromPreflight, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Click="Apply_Click"
                      VerticalAlignment="Center" />
            </Grid>

            <UniformGrid Columns="5"
                         Margin="0,0,0,14">
              <Border BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="5"
                      Padding="12"
                      Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="已存在"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding LabelWorkflow.AlreadyPresentCount}"
                             FontSize="24"
                             FontWeight="SemiBold" />
                </StackPanel>
              </Border>
              <Border BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="5"
                      Padding="12"
                      Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="待创建"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding LabelWorkflow.MissingCount}"
                             FontSize="24"
                             FontWeight="SemiBold" />
                </StackPanel>
              </Border>
              <Border BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="5"
                      Padding="12"
                      Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="重复文字"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding LabelWorkflow.DuplicateCount}"
                             FontSize="24"
                             FontWeight="SemiBold" />
                </StackPanel>
              </Border>
              <Border BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="5"
                      Padding="12"
                      Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="文字冲突"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding LabelWorkflow.TextConflictCount}"
                             FontSize="24"
                             FontWeight="SemiBold" />
                </StackPanel>
              </Border>
              <Border BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="5"
                      Padding="12">
                <StackPanel>
                  <TextBlock Text="检查错误"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding LabelWorkflow.InspectionErrorCount}"
                             FontSize="24"
                             FontWeight="SemiBold" />
                </StackPanel>
              </Border>
            </UniformGrid>

            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="125" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="状态"
                         Foreground="{StaticResource TextSecondaryBrush}" />
              <TextBlock Grid.Column="1"
                         Text="{Binding LabelWorkflow.PreflightStatus}"
                         FontWeight="SemiBold" />
            </Grid>

            <Expander Header="审计详情"
                      IsExpanded="False"
                      Margin="0,0,0,12">
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="125" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="检查 ID"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Text="{Binding LabelWorkflow.PreflightOperationId}"
                           FontFamily="Consolas" />
                <TextBlock Grid.Row="1"
                           Text="Plan Hash"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,6,0,0" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding LabelWorkflow.PlanHash}"
                           FontFamily="Consolas"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
              </Grid>
            </Expander>

            <DataGrid ItemsSource="{Binding LabelWorkflow.PreflightItems}"
                      Height="245">
              <DataGrid.Columns>
                <DataGridTextColumn Header="稳定对象 ID"
                                    Binding="{Binding StableObjectId}"
                                    Width="*" />
                <DataGridTextColumn Header="预期文字"
                                    Binding="{Binding ExpectedText}"
                                    Width="*" />
                <DataGridTextColumn Header="匹配数"
                                    Binding="{Binding MatchCount}"
                                    Width="80" />
                <DataGridTextColumn Header="决策"
                                    Binding="{Binding Decision}"
                                    Width="170" />
                <DataGridTextColumn Header="匹配句柄"
                                    Binding="{Binding MatchHandle}"
                                    Width="180" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Style="{StaticResource CardStyle}"
                Visibility="{Binding LabelWorkflow.HasApplyResult, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <TextBlock Text="标签创建结果"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />
            <UniformGrid Columns="5"
                         Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="状态"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding LabelWorkflow.ApplyStatus}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="已创建"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding LabelWorkflow.CreatedCount}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="失败"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding LabelWorkflow.CreateFailedCount}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="图纸写入数"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding LabelWorkflow.DrawingWriteCount}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="自动保存"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding LabelWorkflow.SavePerformed}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
            </UniformGrid>
            <Border Background="#EAF5EF"
                    BorderBrush="#B7D8C5"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="13"
                    Visibility="{Binding LabelWorkflow.ManualSaveRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="{Binding LabelWorkflow.ManualSaveGuidance}"
                         Foreground="{StaticResource SuccessBrush}"
                         TextWrapping="Wrap"
                         FontWeight="SemiBold" />
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
