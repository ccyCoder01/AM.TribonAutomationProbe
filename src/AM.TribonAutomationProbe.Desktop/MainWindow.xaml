<Window x:Class="AM.TribonAutomationProbe.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="船舶设计智能助手"
        Width="1280"
        Height="900"
        MinWidth="1080"
        MinHeight="760"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{StaticResource PrimaryBrush}"
            Padding="24,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel>
          <TextBlock Text="船舶设计智能助手"
                     Foreground="White"
                     FontSize="25"
                     FontWeight="SemiBold" />
          <TextBlock Text="自然语言任务入口、计划预览与受控执行"
                     Foreground="#D9EAF2"
                     Margin="0,4,0,0"
                     FontSize="14" />
        </StackPanel>

        <Border Grid.Column="1"
                Background="#1C4861"
                CornerRadius="5"
                Padding="12,7"
                VerticalAlignment="Center">
          <TextBlock Text="计划优先 · 写入需确认"
                     Foreground="White"
                     FontWeight="SemiBold" />
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto">
      <Grid Margin="22">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.55*" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0"
                  Style="{StaticResource CardStyle}"
                  Margin="0,0,14,14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="300" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0"
                          Margin="0,0,0,12">
                <TextBlock Text="对话任务入口"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="自然语言只负责解释和生成计划；不会绕过 Console、FileBridge 或写入门禁。"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0" />

                <Border Background="#F3F7F9"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="10"
                        Margin="0,10,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox Grid.ColumnSpan="3"
                              Content="本次会话使用真实模型"
                              IsChecked="{Binding UseRealModel}"
                              FontWeight="SemiBold" />

                    <TextBlock Grid.Row="1"
                               Text="Base URL"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,8,8,0" />
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Text="{Binding AssistantBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding UseRealModel}"
                             Margin="0,8,8,0" />
                    <TextBox Grid.Row="1"
                             Grid.Column="2"
                             Text="{Binding AssistantModel, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding UseRealModel}"
                             Margin="0,8,0,0"
                             ToolTip="模型 ID" />

                    <TextBlock Grid.Row="2"
                               Text="Token"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,8,8,0" />
                    <PasswordBox x:Name="AssistantApiTokenBox"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 IsEnabled="{Binding UseRealModel}"
                                 Margin="0,8,8,0"
                                 ToolTip="只保留到本次解释调用结束；请输入 Token 本身，不含 Bearer 前缀。" />
                    <StackPanel Grid.Row="2"
                                Grid.Column="2"
                                Margin="0,8,0,0">
                      <TextBlock Text="{Binding ModelConfigurationSummary}"
                                 FontSize="11"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="认证：Bearer Token；不写入文件或命令行"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 FontSize="11"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>

              <Border Grid.Row="1"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="5"
                      Background="#F8FAFB"
                      Padding="8">
                <ScrollViewer x:Name="ConversationScrollViewer"
                              VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Padding="11,8"
                                Margin="2,3"
                                MaxWidth="610">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="#EAF0F3" />
                              <Setter Property="CornerRadius" Value="6" />
                              <Setter Property="HorizontalAlignment" Value="Left" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Role}" Value="user">
                                  <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                  <Setter Property="HorizontalAlignment" Value="Right" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Role}" Value="system">
                                  <Setter Property="Background" Value="#FFF3D9" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <StackPanel>
                            <TextBlock Text="{Binding DisplayRole}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,3">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Role}" Value="user">
                                      <Setter Property="Foreground" Value="#D9EAF2" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Content}"
                                       TextWrapping="Wrap">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Role}" Value="user">
                                      <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>

              <TextBox x:Name="UserInputBox"
                       Grid.Row="2"
                       Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"
                       MinHeight="80"
                       MaxHeight="130"
                       Margin="0,12,0,8"
                       KeyDown="UserInput_KeyDown"
                       ToolTip="Ctrl+Enter 生成执行计划" />

              <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Ctrl+Enter 生成计划"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="生成执行计划"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="{Binding CanInterpret}"
                        Click="Interpret_Click"
                        Margin="8,0,0,0" />
                <Button Grid.Column="2"
                        Content="取消"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{Binding CanCancel}"
                        Click="Cancel_Click"
                        Margin="8,0,0,0" />
                <Button Grid.Column="3"
                        Content="清空对话"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="ClearConversation_Click"
                        Margin="8,0,0,0" />
              </Grid>

              <Border Grid.Row="4"
                      Background="#FDECEC"
                      BorderBrush="#E8B7B7"
                      BorderThickness="1"
                      CornerRadius="5"
                      Padding="10"
                      Margin="0,10,0,0"
                      Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap" />
              </Border>
            </Grid>
          </Border>

          <StackPanel Grid.Column="1">
            <Border Style="{StaticResource CardStyle}"
                    Visibility="{Binding HasPlan, Converter={StaticResource BooleanToVisibilityConverter}}">
              <StackPanel>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="执行计划"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PlanMessage}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,5,12,0" />
                  </StackPanel>
                  <Border Grid.Column="1"
                          Background="#E7EEF2"
                          CornerRadius="4"
                          Padding="8,4"
                          VerticalAlignment="Top">
                    <TextBlock Text="{Binding PlanState}"
                               FontWeight="SemiBold" />
                  </Border>
                </Grid>

                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="Plan ID"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding PlanId}"
                             FontFamily="Consolas"
                             TextWrapping="Wrap" />
                  <TextBlock Grid.Row="1"
                             Text="模型"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             Margin="0,5,0,0" />
                  <TextBlock Grid.Row="1"
                             Grid.Column="1"
                             Text="{Binding ModelSummary}"
                             Margin="0,5,0,0" />
                </Grid>

                <ItemsControl ItemsSource="{Binding PlanTasks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1"
                              CornerRadius="5"
                              Padding="10"
                              Margin="0,0,0,8">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Sequence}"
                                     FontSize="18"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource PrimaryBrush}" />
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TaskType}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ConfirmationText}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,2,0,0" />
                          </StackPanel>
                          <Border Grid.Column="2"
                                  Background="#EEF3F6"
                                  CornerRadius="4"
                                  Padding="7,3"
                                  VerticalAlignment="Top">
                            <TextBlock Text="{Binding RiskText}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="#FFF8E8"
                        BorderBrush="#E7D19A"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="10"
                        Margin="0,2,0,10">
                  <TextBlock Text="{Binding PlanSafetySummary}"
                             Foreground="{StaticResource WarningBrush}"
                             TextWrapping="Wrap" />
                </Border>

                <Button Content="{Binding PlanExecutionButtonText}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="{Binding CanExecuteCurrentPlan}"
                        Click="ExecutePlan_Click" />
                <TextBlock Text="{Binding PlanExecutionLifecycleSummary}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Margin="0,7,0,0" />

                <Border Background="#EEF5F7"
                        BorderBrush="#C5D8DF"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="10"
                        Margin="0,8,0,0"
                        Visibility="{Binding ShowReadOnlyExecutionPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <StackPanel>
                    <TextBlock Text="确定性只读执行"
                               FontWeight="SemiBold" />
                    <ProgressBar Value="{Binding ReadOnlyExecutionProgress, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsReadOnlyExecutionProgressIndeterminate, Mode=OneWay}"
                                 Margin="0,7,0,6" />
                    <TextBlock Text="{Binding ReadOnlyExecutionStatus}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ReadOnlyExecutionSummary}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0"
                               Visibility="{Binding HasReadOnlyExecutionResult, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  </StackPanel>
                </Border>

                <TextBlock Text="计划区现在使用统一执行入口：只读任务按 Sequence 进入固定白名单执行器；标签写入计划先执行 preflight，再保持精确绑定、勾选授权和原生确认。Worker、FileBridge 协议和 SAVEWORK 策略均不改变。"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Margin="0,7,0,0" />
              </StackPanel>
            </Border>

            <Expander Header="高级运行设置"
                      IsExpanded="False">
              <Border Style="{StaticResource CardStyle}"
                      Margin="0,8,0,14"
                      IsEnabled="{Binding LabelWorkflow.CanRunPreflight}">
                <StackPanel>
                  <TextBlock Text="普通用户无需修改。路径或等待参数改变后，已有 preflight 将失效。"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             TextWrapping="Wrap"
                             Margin="0,0,0,10" />
                  <TextBlock Text="Console 可执行文件"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                  <Grid Margin="0,4,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding LabelWorkflow.ConsolePath, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,0" />
                    <Button Grid.Column="1"
                            Content="浏览"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BrowseConsole_Click" />
                  </Grid>

                  <TextBlock Text="FileBridge 根目录"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBox Text="{Binding LabelWorkflow.BridgeRoot, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,4,0,10" />

                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="超时 (ms)"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <TextBox Width="110"
                             Text="{Binding LabelWorkflow.TimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="轮询 (ms)"
                               VerticalAlignment="Center"
                               Margin="14,0,6,0" />
                    <TextBox Width="90"
                             Text="{Binding LabelWorkflow.PollIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </Expander>
          </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}">
          <StackPanel>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="确定性标签工作流"
                           FontSize="17"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding LabelWorkflow.StatusMessage}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,5,18,0" />
              </StackPanel>
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          VerticalAlignment="Center">
                <Button Content="执行标签只读检查"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{Binding LabelWorkflow.CanRunPreflight}"
                        Click="RunPreflight_Click"
                        Margin="0,0,8,0" />
                <Button Content="取消"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{Binding CanCancel}"
                        Click="Cancel_Click" />
              </StackPanel>
            </Grid>

            <ProgressBar Value="{Binding LabelWorkflow.ProgressPercent, Mode=OneWay}"
                         IsIndeterminate="{Binding LabelWorkflow.IsProgressIndeterminate}" />

            <Border Background="#FDECEC"
                    BorderBrush="#E8B7B7"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="12"
                    Margin="0,12,0,0"
                    Visibility="{Binding LabelWorkflow.HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="{Binding LabelWorkflow.ErrorMessage}"
                         Foreground="{StaticResource ErrorBrush}"
                         TextWrapping="Wrap" />
            </Border>

            <Border Background="#FFF8E8"
                    BorderBrush="#E7D19A"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="12"
                    Margin="0,12,0,0">
              <TextBlock Foreground="{StaticResource WarningBrush}"
                         TextWrapping="Wrap">
                <Run Text="每次只读检查或 Apply 提交后，" />
                <Run Text="必须在 Tribon 当前图纸中运行 Start.py 恰好一次。" FontWeight="Bold" />
                <Run Text=" 本程序不会自动执行 Start.py，也不会执行 SAVEWORK。" />
              </TextBlock>
            </Border>
          </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Visibility="{Binding LabelWorkflow.HasPreflight, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <TextBlock Text="只读检查结果"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Margin="0,0,0,14" />

            <UniformGrid Columns="5"
                         Margin="0,0,0,14">
              <Border BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="5"
                      Padding="12"
                      Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="已存在"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding LabelWorkflow.AlreadyPresentCount}"
                             FontSize="24"
                             FontWeight="SemiBold" />
                </StackPanel>
              </Border>
              <Border BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="5"
                      Padding="12"
                      Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="待创建"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding LabelWorkflow.MissingCount}"
                             FontSize="24"
                             FontWeight="SemiBold" />
                </StackPanel>
              </Border>
              <Border BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="5"
                      Padding="12"
                      Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="重复文字"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding LabelWorkflow.DuplicateCount}"
                             FontSize="24"
                             FontWeight="SemiBold" />
                </StackPanel>
              </Border>
              <Border BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="5"
                      Padding="12"
                      Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="文字冲突"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding LabelWorkflow.TextConflictCount}"
                             FontSize="24"
                             FontWeight="SemiBold" />
                </StackPanel>
              </Border>
              <Border BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="5"
                      Padding="12">
                <StackPanel>
                  <TextBlock Text="检查错误"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding LabelWorkflow.InspectionErrorCount}"
                             FontSize="24"
                             FontWeight="SemiBold" />
                </StackPanel>
              </Border>
            </UniformGrid>

            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="125" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0"
                         Text="状态"
                         Foreground="{StaticResource TextSecondaryBrush}" />
              <TextBlock Grid.Row="0"
                         Grid.Column="1"
                         Text="{Binding LabelWorkflow.PreflightStatus}"
                         FontWeight="SemiBold" />
              <TextBlock Grid.Row="1"
                         Text="Preflight ID"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         Margin="0,6,0,0" />
              <TextBlock Grid.Row="1"
                         Grid.Column="1"
                         Text="{Binding LabelWorkflow.PreflightOperationId}"
                         FontFamily="Consolas"
                         Margin="0,6,0,0" />
              <TextBlock Grid.Row="2"
                         Text="Plan Hash"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         Margin="0,6,0,0" />
              <TextBlock Grid.Row="2"
                         Grid.Column="1"
                         Text="{Binding LabelWorkflow.PlanHash}"
                         FontFamily="Consolas"
                         TextWrapping="Wrap"
                         Margin="0,6,0,0" />
            </Grid>

            <DataGrid ItemsSource="{Binding LabelWorkflow.PreflightItems}"
                      Height="245">
              <DataGrid.Columns>
                <DataGridTextColumn Header="稳定对象 ID"
                                    Binding="{Binding StableObjectId}"
                                    Width="*" />
                <DataGridTextColumn Header="预期文字"
                                    Binding="{Binding ExpectedText}"
                                    Width="*" />
                <DataGridTextColumn Header="匹配数"
                                    Binding="{Binding MatchCount}"
                                    Width="80" />
                <DataGridTextColumn Header="决策"
                                    Binding="{Binding Decision}"
                                    Width="170" />
                <DataGridTextColumn Header="匹配句柄"
                                    Binding="{Binding MatchHandle}"
                                    Width="180" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Style="{StaticResource CardStyle}"
                Visibility="{Binding LabelWorkflow.HasPreflight, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="受控 Apply"
                         FontSize="17"
                         FontWeight="SemiBold" />
              <TextBlock Text="Apply 仅创建当前 preflight 中 READY_TO_CREATE 的精确 operation 集合；不会自动保存。"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         TextWrapping="Wrap"
                         Margin="0,5,20,10" />
              <CheckBox IsChecked="{Binding LabelWorkflow.ApplyAcknowledged, Mode=TwoWay}"
                        IsEnabled="{Binding LabelWorkflow.HasWritablePreflight}"
                        Content="我已核对待创建数量、Plan Hash 和对象列表，并授权本次写入。" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="创建缺失标签"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsEnabled="{Binding LabelWorkflow.CanApply}"
                    Click="Apply_Click"
                    VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Border Grid.Row="4"
                Style="{StaticResource CardStyle}"
                Visibility="{Binding LabelWorkflow.HasApplyResult, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <TextBlock Text="Apply 结果"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />
            <UniformGrid Columns="5"
                         Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="状态"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding LabelWorkflow.ApplyStatus}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="已创建"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding LabelWorkflow.CreatedCount}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="失败"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding LabelWorkflow.CreateFailedCount}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="图纸写入数"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding LabelWorkflow.DrawingWriteCount}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="自动保存"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding LabelWorkflow.SavePerformed}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
            </UniformGrid>
            <Border Background="#EAF5EF"
                    BorderBrush="#B7D8C5"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="13"
                    Visibility="{Binding LabelWorkflow.ManualSaveRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="{Binding LabelWorkflow.ManualSaveGuidance}"
                         Foreground="{StaticResource SuccessBrush}"
                         TextWrapping="Wrap"
                         FontWeight="SemiBold" />
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
